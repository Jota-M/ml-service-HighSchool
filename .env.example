# ─────────────────────────────────────────────────────────
# ml-service/.env.example
# Copia este archivo como .env y completa los valores
#
#   cp .env.example .env
#
# NUNCA subas .env a git — ya está en .gitignore
# ─────────────────────────────────────────────────────────


# ── APLICACIÓN ────────────────────────────────────────────

# Modo debug — muestra logs detallados
# En producción cambiar a false
DEBUG=false


# ── GEMINI API ────────────────────────────────────────────

# API key de Google AI Studio (gratuita)
# Obtén la tuya en: https://aistudio.google.com/app/apikey
# Si la dejas vacía el sistema funciona sin análisis narrativo
GEMINI_API_KEY=AIzaSyDmvdr2OQwLo1P6QuQ2O_Uv6pFRozBfLbw

# Modelo de Gemini a usar
# gemini-1.5-flash  → gratuito, rápido, recomendado
# gemini-1.5-pro    → más capaz pero con límites más bajos
GEMINI_MODEL=gemini-1.5-flash


# ── MODELO ML ─────────────────────────────────────────────

# Modelo principal para predicciones
# xgboost      → 95.42% accuracy (recomendado)
# random_forest → 95.28% accuracy
MODELO_PRINCIPAL=xgboost
